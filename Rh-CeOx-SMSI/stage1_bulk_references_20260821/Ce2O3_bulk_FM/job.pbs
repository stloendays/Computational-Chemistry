#!/usr/bin/env bash
#PBS -N dsmsi_Ce2O3_bulk_FM
#PBS -P CFP03-CF-126
#PBS -l select=1:ncpus=36:mpiprocs=36:ompthreads=1:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
for f in INCAR POSCAR KPOINTS POTCAR; do
  test -s "$f" || { echo "Missing or empty $f" >&2; exit 2; }
done

module purge
module load intel/2021b
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
VASP_BIN=/nfs/home/svu/junbotong/software/vasp/NUS_HPC_VASP/vasp_632_vtst_solpp_beef_std
test -x "$VASP_BIN" || { echo "VASP executable not found: $VASP_BIN" >&2; exit 2; }
if ldd "$VASP_BIN" | grep -q 'not found'; then
  echo "Missing runtime library for VASP" >&2
  exit 2
fi
NP=$(wc -l < "$PBS_NODEFILE")
rm -f STOPCAR
mpirun -np "$NP" "$VASP_BIN" > vasp.out &
VASP_PID=$!
(
  sleep 1500
  if kill -0 "$VASP_PID" 2>/dev/null; then
    printf '%s\n' 'LSTOP = .TRUE.' > STOPCAR
    echo "watchdog_requested_stop=$(date --iso-8601=seconds)"
  fi
) &
WATCHDOG_PID=$!
set +e
wait "$VASP_PID"
RC=$?
set -e
kill "$WATCHDOG_PID" 2>/dev/null || true
wait "$WATCHDOG_PID" 2>/dev/null || true
rm -f STOPCAR
exit "$RC"
