#!/usr/bin/env bash
# Server-side stage-7 monitor (user 2026-11-20: "在服务器端做一个自动续算的脚本，不需要本地电脑来做").
# Vanda forbids crontab, so this small free job (auto_free, 1 core) runs monitor_stage7.py - the same deterministic
# script the local scheduled task runs: checks, CONTCAR -> POSCAR resumes, qsub, records - then queues its own next run
# with qsub -a (start no earlier than now + INTERVAL_H). The monitor's mkdir lock keeps it from overlapping a local run.
#   stop:      touch monitor/server/STOP        (the chain ends at its next run; or qdel the waiting s7mon job)
#   interval:  echo 3 > monitor/server/INTERVAL_H   (hours; default 5)
#   log:       monitor/server/server_monitor.log (one line per run), last full report monitor/server/last_run.txt
#PBS -N s7mon
#PBS -q auto_free
#PBS -P CFP04-CF-046
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /scratch/junbotong/Dynamic_SMSI_stage7_first_CH_cleavage_20261015/monitor/server/s7mon.pbs.out

set -uo pipefail
S=/scratch/junbotong/Dynamic_SMSI_stage7_first_CH_cleavage_20261015
H=$S/monitor/server
LOG=$H/server_monitor.log
cd "$S"
now () { date +%Y-%m-%dT%H:%M:%S; }

# compute nodes have no `hpc` (quota and allocation checks), so the monitor runs on a login node over the cluster's
# internal ssh (probe 1595612, 11-20); only if no login node answers does it run here (quota gate then skipped).
RC=255
for L in stdct-login-01 stdct-login-02; do
  timeout 3000 ssh -o BatchMode=yes -o ConnectTimeout=30 -o StrictHostKeyChecking=no "$L" \
    "cd $S && python3 monitor/monitor_stage7.py" > "$H/last_run.txt" 2>&1
  RC=$?
  grep -q '^===FLAGS===' "$H/last_run.txt" && break
done
if ! grep -q '^===FLAGS===' "$H/last_run.txt"; then
  echo "$(now) no login node answered (rc=$RC); running on $(hostname)" >> "$LOG"
  python3 monitor/monitor_stage7.py > "$H/last_run.txt" 2>&1
  RC=$?
fi
ATT=$(grep -m1 '^ATTENTION=' "$H/last_run.txt" | cut -d= -f2)
DONE=$(grep -m1 '^DONE=' "$H/last_run.txt" | cut -d= -f2)
ACT=$(sed -n '/^===ACTIONS===/,/^===ATTN===/p' "$H/last_run.txt" | grep -v '^===' | tr '\n' ' ' | cut -c1-300)
echo "$(now) job=${PBS_JOBID:-manual} rc=$RC attention=${ATT:-?} done=${DONE:-?} actions: ${ACT:-none}" >> "$LOG"

# queue the next run unless stopped / finished / already queued
if [ -e "$H/STOP" ]; then echo "$(now) STOP present: chain ended" >> "$LOG"; exit 0; fi
if [ "${DONE:-0}" = "1" ]; then echo "$(now) monitor reports DONE: chain ended" >> "$LOG"; exit 0; fi
# 11-21: link 1598628 (due 11-21 00:25) was held by PBS ("too many failed attempts to run", Exit -3, run_count 21 -
# a node-side start failure, as CI-NEB A 1539627 on 11-11) and the single-successor chain stopped. Now every run
# (1) qdel's held s7mon links and (2) keeps two waiting links, at +IV and +2*IV, so one held link costs one interval.
MINE=${PBS_JOBID%%.*}
for J in $(qselect -u "$USER" -N s7mon -s H 2>/dev/null | grep -v "^$MINE\."); do
  qdel "$J" 2>/dev/null && echo "$(now) held link $J deleted" >> "$LOG"
done
NW=$(qselect -u "$USER" -N s7mon -s QW 2>/dev/null | grep -v "^$MINE\." | grep -c .)
IV=$(cat "$H/INTERVAL_H" 2>/dev/null || echo 5); IV=${IV%%.*}; [ "${IV:-0}" -ge 1 ] 2>/dev/null || IV=5
case "$NW" in 0) OFFS="$IV $((2 * IV))" ;; 1) OFFS="$((2 * IV))" ;; *) OFFS="" ;; esac
[ -n "$OFFS" ] || { echo "$(now) $NW links already waiting: not resubmitting" >> "$LOG"; exit 0; }
bash "$HOME/hpc_login.sh" > /dev/null 2>&1
RCALL=0
for OFF in $OFFS; do
  AT=$(date -d "+${OFF} hours" +%Y%m%d%H%M); ok=0
  for try in 1 2 3; do
    J=$(qsub -a "$AT" "$H/server_monitor.pbs" 2>&1) && { echo "$(now) next run $J at $AT" >> "$LOG"; ok=1; break; }
    sleep 120
  done
  [ $ok = 1 ] || { echo "$(now) RESUBMIT FAILED for +${OFF} h: $J" >> "$LOG"; RCALL=1; }
done
exit $RCALL
