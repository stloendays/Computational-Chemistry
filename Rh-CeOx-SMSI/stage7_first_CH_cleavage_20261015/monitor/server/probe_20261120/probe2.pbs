#!/usr/bin/env bash
#PBS -N s7mon_probe2
#PBS -q auto_free
#PBS -P CFP04-CF-046
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe
cd "$PBS_O_WORKDIR"
echo host=$(hostname)
type hpc 2>&1
hpc project 2>&1 | head -5
hpc space 2>&1 | head -5
timeout 30 ssh -o BatchMode=yes -o StrictHostKeyChecking=no stdct-login-01 "hostname; hpc project | grep -c CFP04-CF-046" 2>&1 | tail -3
