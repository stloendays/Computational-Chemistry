#!/usr/bin/env bash
#PBS -N s7f_A05_freq
#PBS -P CFP04-CF-046
#PBS -l select=1:ncpus=36:mpiprocs=36:ompthreads=1:mem=200gb
#PBS -l walltime=72:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
for f in INCAR POSCAR KPOINTS POTCAR WAVECAR; do
  test -s "$f" || { echo "Missing or empty $f" >&2; exit 2; }
done
module purge
module load intel/2021b
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
VASP_BIN=/nfs/home/svu/junbotong/software/vasp/NUS_HPC_VASP/vasp_632_vtst_solpp_beef_std
test -x "$VASP_BIN" || { echo "VASP executable not found: $VASP_BIN" >&2; exit 2; }
NP=$(wc -l < "$PBS_NODEFILE")
echo "job_id=$PBS_JOBID host=$(hostname) ranks=$NP workdir=$PBS_O_WORKDIR start=$(date --iso-8601=seconds)"
START=$(date +%s)
rm -f STOPCAR
mpirun -np "$NP" "$VASP_BIN" > vasp_freq.out &
VP=$!
# watchdog at 250200 s (69.5 h): finite differences cannot be resumed, LABORT keeps the outputs
( while kill -0 "$VP" 2>/dev/null; do
    if [ $(( $(date +%s) - START )) -ge 250200 ]; then printf 'LABORT = .TRUE.\n' > STOPCAR; echo watchdog_stop; break; fi
    sleep 60; done ) &
WD=$!
set +e; wait "$VP"; RC=$?; set -e
kill "$WD" 2>/dev/null || true; wait "$WD" 2>/dev/null || true
rm -f STOPCAR
echo "end=$(date --iso-8601=seconds) rc=$RC"
grep -q "Eigenvectors and eigenvalues of the dynamical matrix" OUTCAR && echo "FREQ done" || echo "FREQ NOT done"
grep " f/i=" OUTCAR || true
exit "$RC"
